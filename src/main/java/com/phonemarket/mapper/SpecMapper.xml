<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.phonemarket.mapper.SpecMapper">
    <resultMap type="Spec" id="BaseResultMap">
        <id property="specId" column="spec_id" javaType="java.lang.Integer" />
        <result property="specName" column="spec_name" javaType="java.lang.String" />
    </resultMap>

    <select id="findSpecById" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        select * from spec where spec_id=#{id}
    </select>

    <insert id="addSpec" parameterType="Spec">
        <selectKey resultType="java.lang.Integer" order="AFTER" keyProperty="specId">
            SELECT LAST_INSERT_ID()
        </selectKey>
        insert into spec(spec_name) values(#{specName})
    </insert>

    <update id="deleteSpec" parameterType="java.lang.Integer">
        update spec set spec_state=-1 where spec_id=#{id}
    </update>

    <update id="updateSpec" parameterType="Spec">
        update spec
        <set>
            <if test="specName!=null and specName!=''">
                spec_name=#{specName},
            </if>
        </set>
        where spec_id=#{specId}
    </update>

    <select id="findAllSpec" resultMap="BaseResultMap">
        select * from spec where spec_state &gt; 0
    </select>
</mapper>
