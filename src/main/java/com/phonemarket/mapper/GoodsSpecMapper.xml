<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.phonemarket.mapper.GoodsSpecMapper">
    <resultMap type="GoodsSpec" id="BaseResultMap">
        <id property="goodsSpecId" column="goods_spec_id" javaType="java.lang.Integer" />
        <result property="goods.goodsId" column="goods_id" javaType="java.lang.Integer" />
        <result property="specValueIds" column="spec_value_ids" javaType="java.lang.String" />
        <result property="goodsNum" column="goods_num" javaType="java.lang.Integer" />
    </resultMap>

    <resultMap type="GoodsSpec" id="BaseResultMapJoinObj" extends="BaseResultMap">
        <association property="goods" javaType="Goods" column="goods_id" select="com.phonemarket.mapper.GoodsMapper.findGoodsById"></association>
    </resultMap>

    <select id="findGoodsSpecById" parameterType="java.lang.Integer" resultMap="BaseResultMapJoinObj">
        select * from goods_spec where goods_spec_id=#{id}
    </select>

    <insert id="addGoodsSpec" parameterType="GoodsSpec">
        <selectKey resultType="java.lang.Integer" order="AFTER" keyProperty="goodsSpecId">
            SELECT LAST_INSERT_ID()
        </selectKey>
        insert into goods_spec(goods_id, spec_value_ids, goods_num) values(#{goods.goodsId}, #{specValueIds}, #{goodsNum})
    </insert>

    <update id="deleteGoodsSpec" parameterType="java.lang.Integer">
        update goods_spec set goods_spec_state=-1 where goods_spec_id=#{id}
    </update>

    <update id="updateGoodsSpec" parameterType="GoodsSpec">
        update goods_spec
        <set>
            <if test="goods!=null and goods.goodsId!=null">
                goods_id=#{goods.goodsId},
            </if>
            <if test="specValueIds!=null and specValueIds!=''">
                spec_value_ids=#{specValueIds},
            </if>
            <if test="goodsNum!=null">
                goods_num=#{goodsNum},
            </if>
        </set>
        where goods_spec_id=#{goodsSpecId}
    </update>

    <select id="findGoodsSpecByGoodsId" parameterType="java.lang.Integer" resultMap="BaseResultMapJoinObj">
        select * from goods_spec where goods_id=#{goodsId} and goods_spec_state &gt; 0
    </select>

    <select id="findGoodsSpecByGoodsIdAndSpecValueIds" parameterType="java.lang.Integer" resultMap="BaseResultMapJoinObj">
        select * from goods_spec where goods_id=#{goodsId} and spec_value_ids=#{specValueIds} and goods_spec_state &gt; 0
    </select>
</mapper>
